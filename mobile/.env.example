# mobile/.env.local
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_DEV_API_URL=
API_URL=

GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

ENABLE_2FA=
ENABLE_REGISTRATION_OTP=
ENABLE_OTP_DELIVERY=
# Google sign-in (OAuth client IDs from Google Cloud → Credentials)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── Two apps from one codebase ──────────────────────────────────────────────
# APP_VARIANT is set by the eas.json profiles (…-customer / …-driver) or by `pnpm start:customer` / `pnpm start:driver`.
# The driver app needs its own Expo project (run `eas init` with APP_VARIANT=driver) and its own Firebase files:
#   GoogleService-Info.driver.plist and google-services.driver.json (bundle/package org.runserv.driver)
EAS_PROJECT_ID_DRIVER=
# Store links shown on the "wrong app" screen (https only)
CUSTOMER_APP_IOS_URL=
CUSTOMER_APP_ANDROID_URL=
DRIVER_APP_IOS_URL=
DRIVER_APP_ANDROID_URL=

# Road routing for the map (OSRM-compatible). Default is the public demo server: DEVELOPMENT ONLY.
# EXPO_PUBLIC_ROUTING_URL=https://your-osrm-or-valhalla.example.com

# M14: map renderer / tile style are now controlled from the admin console (Map provider). These are only the defaults used
# before the server answers on a first launch. Road routing is always requested from the server (no routing keys in the app).
# EXPO_PUBLIC_MAP_RENDERER=maplibre
# EXPO_PUBLIC_MAP_STYLE_URL=
