VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_ENABLE_SHIELD=false
# Organisations are the core Runserv product and are ON by default. Set to false only to hide them.
VITE_ENABLE_CORPORATE=true
VITE_ENABLE_DUOPAY=false
# Staged activation — mirror the backend ENABLE_FLEET / ENABLE_BANK_OFFERS switches. Set false to hide the areas.
VITE_ENABLE_FLEET=true
VITE_ENABLE_BANK_OFFERS=true
VITE_GOOGLE_CLIENT_ID=
