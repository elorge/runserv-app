// ─────────────────────────────────────────────────────────────────────────────
// M7 ADDITIONS
// ─────────────────────────────────────────────────────────────────────────────

enum LedgerDirection {
  DEBIT
  CREDIT
}

// Append-only financial ledger (double entry: the DEBIT and CREDIT legs of one event always balance). The database itself
// refuses UPDATE, DELETE and TRUNCATE on this table (see prisma/sql/post_migrate.sql); corrections are new, opposite entries.
model LedgerEntry {
  id             String          @id @default(uuid())
  entryGroup     String
  account        String
  currency       String
  direction      LedgerDirection
  amount         Decimal         @db.Decimal(14, 2)
  refType        String
  refId          String
  memo           String?
  actorId        String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)

  @@index([account, createdAt])
  @@index([refType, refId])
  @@index([entryGroup])
}

// One uploaded bank statement. The file's SHA-256 is unique per bank, so the same file can never be imported twice.
model StatementImport {
  id             String   @id @default(uuid())
  bankPartnerId  String
  fileName       String
  sha256         String
  rowCount       Int      @default(0)
  createdCount   Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  errors         Json?
  importedById   String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([bankPartnerId, sha256])
  @@index([createdAt])
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  WON
  LOST
}

// Requests from the public landing page.
model DemoRequest {
  id           String            @id @default(uuid())
  name         String
  email        String
  phone        String?
  organisation String?
  interest     String
  message      String?
  status       DemoRequestStatus @default(NEW)
  ipHash       String?
  handledById  String?
  notes        String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([email])
}

enum MoneyActionKind {
  ORG_WALLET_CREDIT
  ORG_WALLET_ADJUST
  INVOICE_RECEIPT
  BANK_CREDIT_REVERSAL
}

enum MoneyActionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Staff-entered money that affects a company (a bank transfer they saw, an adjustment, a receipt on an invoice) is only a
// REQUEST until a different admin approves it. Nothing is credited, and no invoice is marked paid, before that.
model PendingMoneyAction {
  id            String            @id @default(uuid())
  kind          MoneyActionKind
  targetId      String
  amount        Decimal           @db.Decimal(14, 2)
  currency      String
  reason        String
  payload       Json?
  status        MoneyActionStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?         @db.Timestamptz(6)
  decisionNote  String?
  alertedAt     DateTime?         @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([targetId])
}

// M13: transactional outbox. Written in the SAME transaction as trip completion; processed asynchronously with retry / dead-letter.
model OutboxEvent {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([type, aggregateType, aggregateId])
  @@index([status, nextAttemptAt])
}
