# Database
# Supabase → Project Settings → Database. DATABASE_URL = the POOLED string (port 6543); DIRECT_URL = the DIRECT string (port 5432).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=3000
NODE_ENV=

GOOGLE_PLACES_API_KEY=

# Payment (Get from Paystack and Flutterwave dashboards)
CLIENT_URL=https://yourdomain.com

# email service
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BREVO_API_KEY=

# SMS service
TERMII_API_KEY=
TERMII_SENDER_ID=

OTP_DEFAULT_METHOD=

ENABLE_2FA=
ENABLE_REGISTRATION_OTP=
ENABLE_OTP_DELIVERY=
ENABLE_PASSWORD_CHANGE_OTP=
ENABLE_SMS_DELIVERY=
ENABLE_EMAIL_DELIVERY=
ENABLE_EMAIL_VERIFICATION=
REQUIRE_EMAIL_VERIFICATION=

APP_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Set to 'true' when you are ready to enable each feature
ENABLE_SHIELD=false
# Organisations (company rides, monthly invoices, driver settlement) are ON by default.
ENABLE_CORPORATE=true
# Set true to stop the in-process invoice scheduler (e.g. if you run scripts/run-monthly-billing.js from cron instead).
DISABLE_ORG_BILLING_SCHEDULER=false
ENABLE_DUOPAY=false

PAYOUT_PROVIDER=

# Payment (Test keys for development)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Payment — Flutterwave (LIVE keys)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=

APP_STORE_URL=
PLAY_STORE_URL=

# ── Orange — checkout (required to activate) ──────────────────────────────
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_AUTHORISATION_HEADER=

ORANGE_WEBPAY_COUNTRY=dev

ORANGE_RETURN_URL=
ORANGE_CANCEL_URL=
ORANGE_NOTIF_URL=

ORANGE_WEBHOOK_SECRET=

ORANGE_B2C_ENABLED=
ORANGE_MERCHANT_MSISDN=
ORANGE_B2C_PIN=
ORANGE_B2C_PARTNER_ID_TYPE=

# ── Runserv Business ────────────────────────────────────────────────────────
# Organisations (company rides, wallet/credit, monthly invoices, driver settlement) are ON by default.
ENABLE_CORPORATE=true
# Stop the in-process invoice scheduler if you run `pnpm billing:run` from cron instead.
DISABLE_ORG_BILLING_SCHEDULER=false
# White label: each organisation's portal is <slug>.<PORTAL_BASE_DOMAIN> (or its own custom domain).
PORTAL_BASE_DOMAIN=business.runserv.org

# ── Google sign-in ──────────────────────────────────────────────────────────
# Comma-separated OAuth client IDs (web, iOS, Android) from Google Cloud → Credentials.
GOOGLE_CLIENT_IDS=


# ── Fleet partners & bank offers ────────────────────────────────────────────
ENABLE_FLEET=true
ENABLE_BANK_OFFERS=true
# Mandatory vehicle documents (insurance, roadworthy, permit). Confirm with Lagos authorities and counsel before launch.
FLEET_REQUIRED_VEHICLE_DOCS=insurance,roadworthy
# One secret per bank: {"<bankPartnerId>":"secret"}. Never commit real values.
BANK_WEBHOOK_SECRETS={}
# Keep false until a written Nigerian legal assessment exists.
BANK_CREDIT_OFFERS_ENABLED=false
# Keep false until Decision 4 (who funds a bank discount; what the driver is paid on) is made. While false, discount / cashback /
# sponsored-trip offers are not shown, viewed, clicked, quoted or redeemed, so no customer is promised a discount the app cannot apply.
BANK_TRIP_BENEFITS_ENABLED=false
# Second-admin approval. Set to "off" only knowingly, on a single-admin setup.
BANK_MAKER_CHECKER=on
FLEET_MAKER_CHECKER=on
# Cloudinary: needed for fleet document uploads. The cloud name is also used to accept only Runserv-stored document links.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Schedule: node scripts/release-stale-redemptions.js  (every 15 min) gives back budget held by abandoned bank-offer reservations.

# ── M6: security and bank receipts ──────────────────────────────────────────
# NODE_ENV MUST be set. Anything other than "development" or "test" is treated as production (strict CORS, strict start-up checks).
# In production the server REFUSES to start if JWT_SECRET is shorter than 32 characters or looks like a placeholder.
# ADMIN_URL / CLIENT_URL are the browser origins allowed to call the API (e.g. https://admin.runserv.org).
ADMIN_URL=
# Banks pay Runserv into Runserv's own account AT THAT BANK and notify Runserv (signed callback). Per-bank secrets are
# generated in Admin → Banks → Accounts & receipts and stored ENCRYPTED with this key (32+ random characters). Keep it
# outside the database and never change it without re-generating every bank's secret.
BANK_SECRETS_KEY=
# Set to false to ignore payment notices (referral callbacks keep working).
BANK_RECEIPTS_ENABLED=true

# ── M7 additions ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Staff two-step sign-in (authenticator app). The API is built; the admin sign-in SCREEN for it is not yet, so keep this false until it is.
# When true, every staff account must enrol and verify before any other route works.
REQUIRE_STAFF_MFA=false
# Encrypts each staff member's authenticator secret (32+ random characters; falls back to BANK_SECRETS_KEY, then JWT_SECRET). Do not change it
# later without resetting everyone's authenticator.
MFA_ENCRYPTION_KEY=
STAFF_JWT_EXPIRES_IN=12h
# Largest single wallet adjustment / bonus / company credit request a normal admin may make (a Super Admin is not limited).
ADMIN_WALLET_ADJUST_MAX=200000
# Where the landing-page "request a demo" form sends a notification (leave empty to only store requests).
DEMO_NOTIFY_EMAIL=

# M12
# CORS: Vercel preview wildcard is OFF in production unless set (staging only).
ALLOW_VERCEL_PREVIEW_ORIGINS=false
# Destructive dev scripts: DB host must be local unless listed here (comma-separated). Leave empty in production.
DESTRUCTIVE_SCRIPT_ALLOWED_HOSTS=

# ─── M13 ──────────────────────────────────────────────────────────────────────
# Which vehicle categories are in service (CAR for the Lagos pilot). Default: CAR,MOTORCYCLE,VAN. TRICYCLE is out until listed.
ENABLED_VEHICLE_CATEGORIES=CAR
# Licence classes permitted per category. SET ONLY AFTER QUALIFIED NIGERIAN ADVICE. No rule configured = drivers blocked (fails closed).
LICENCE_CLASS_RULES={"CAR":["<class from adviser>"]}
# true/false. Default: ON when NODE_ENV=production, OFF otherwise.
ENFORCE_LICENCE_ELIGIBILITY=true
# Trip-completed outbox worker (set to "off" only on a secondary instance); attempts before dead-letter.
OUTBOX_WORKER=on
OUTBOX_MAX_ATTEMPTS=8

# ─── M14: map provider (these are only STARTING defaults; the admin console setting wins) ───
MAP_RENDERER=maplibre            # maplibre | google | osm
MAP_ROUTING_PROVIDER=osrm        # osrm | google
MAP_PLACES_PROVIDER=auto         # auto | photon | google
MAP_STYLE_URL=                   # https MapLibre style (optional)
OSRM_URL=                        # YOUR routing server (the public demo is dev-only)
GOOGLE_ROUTES_API_KEY=           # server-side; enables Google routing in the admin console
# M14 production: the public OSRM demo is refused in production. Only set this to true for a deliberate, temporary exception.
# ALLOW_PUBLIC_OSRM=false
