# Database
# Supabase → Project Settings → Database. DATABASE_URL = the POOLED string (port 6543); DIRECT_URL = the DIRECT string (port 5432).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=3000
NODE_ENV=

GOOGLE_PLACES_API_KEY=

# Payment (Get from Paystack and Flutterwave dashboards)
CLIENT_URL=https://yourdomain.com

# email service
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BREVO_API_KEY=

# SMS service
TERMII_API_KEY=
TERMII_SENDER_ID=

OTP_DEFAULT_METHOD=

ENABLE_2FA=
ENABLE_REGISTRATION_OTP=
ENABLE_OTP_DELIVERY=
ENABLE_PASSWORD_CHANGE_OTP=
ENABLE_SMS_DELIVERY=
ENABLE_EMAIL_DELIVERY=
ENABLE_EMAIL_VERIFICATION=
REQUIRE_EMAIL_VERIFICATION=

APP_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Set to 'true' when you are ready to enable each feature
ENABLE_SHIELD=false
# Organisations (company rides, monthly invoices, driver settlement) are ON by default.
ENABLE_CORPORATE=true
# Set true to stop the in-process invoice scheduler (e.g. if you run scripts/run-monthly-billing.js from cron instead).
DISABLE_ORG_BILLING_SCHEDULER=false
ENABLE_DUOPAY=false

PAYOUT_PROVIDER=

# Payment (Test keys for development)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Payment — Flutterwave (LIVE keys)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=

APP_STORE_URL=
PLAY_STORE_URL=

# ── Orange — checkout (required to activate) ──────────────────────────────
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_AUTHORISATION_HEADER=

ORANGE_WEBPAY_COUNTRY=dev

ORANGE_RETURN_URL=
ORANGE_CANCEL_URL=
ORANGE_NOTIF_URL=

ORANGE_WEBHOOK_SECRET=

ORANGE_B2C_ENABLED=
ORANGE_MERCHANT_MSISDN=
ORANGE_B2C_PIN=
ORANGE_B2C_PARTNER_ID_TYPE=

# ── Runserv Business ────────────────────────────────────────────────────────
# Organisations (company rides, wallet/credit, monthly invoices, driver settlement) are ON by default.
ENABLE_CORPORATE=true
# Stop the in-process invoice scheduler if you run `pnpm billing:run` from cron instead.
DISABLE_ORG_BILLING_SCHEDULER=false
# White label: each organisation's portal is <slug>.<PORTAL_BASE_DOMAIN> (or its own custom domain).
PORTAL_BASE_DOMAIN=business.runserv.org

# ── Google sign-in ──────────────────────────────────────────────────────────
# Comma-separated OAuth client IDs (web, iOS, Android) from Google Cloud → Credentials.
GOOGLE_CLIENT_IDS=


# ── Fleet partners & bank offers ────────────────────────────────────────────
ENABLE_FLEET=true
ENABLE_BANK_OFFERS=true
# Mandatory vehicle documents (insurance, roadworthy, permit). Confirm with Lagos authorities and counsel before launch.
FLEET_REQUIRED_VEHICLE_DOCS=insurance,roadworthy
# One secret per bank: {"<bankPartnerId>":"secret"}. Never commit real values.
BANK_WEBHOOK_SECRETS={}
# Keep false until a written Nigerian legal assessment exists.
BANK_CREDIT_OFFERS_ENABLED=false
# Keep false until Decision 4 (who funds a bank discount; what the driver is paid on) is made. While false, discount / cashback /
# sponsored-trip offers are not shown, viewed, clicked, quoted or redeemed, so no customer is promised a discount the app cannot apply.
BANK_TRIP_BENEFITS_ENABLED=false
# Second-admin approval. Set to "off" only knowingly, on a single-admin setup.
BANK_MAKER_CHECKER=on
FLEET_MAKER_CHECKER=on
# Cloudinary: needed for fleet document uploads. The cloud name is also used to accept only Runserv-stored document links.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Schedule: node scripts/release-stale-redemptions.js  (every 15 min) gives back budget held by abandoned bank-offer reservations.

# ── M6: security and bank receipts ──────────────────────────────────────────
# NODE_ENV MUST be set. Anything other than "development" or "test" is treated as production (strict CORS, strict start-up checks).
# In production the server REFUSES to start if JWT_SECRET is shorter than 32 characters or looks like a placeholder.
# ADMIN_URL / CLIENT_URL are the browser origins allowed to call the API (e.g. https://admin.runserv.org).
ADMIN_URL=
# Banks pay Runserv into Runserv's own account AT THAT BANK and notify Runserv (signed callback). Per-bank secrets are
# generated in Admin → Banks → Accounts & receipts and stored ENCRYPTED with this key (32+ random characters). Keep it
# outside the database and never change it without re-generating every bank's secret.
BANK_SECRETS_KEY=
# Set to false to ignore payment notices (referral callbacks keep working).
BANK_RECEIPTS_ENABLED=true

# ── M7 additions ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Staff two-step sign-in (authenticator app). The API is built; the admin sign-in SCREEN for it is not yet, so keep this false until it is.
# When true, every staff account must enrol and verify before any other route works.
REQUIRE_STAFF_MFA=false
# Encrypts each staff member's authenticator secret (32+ random characters; falls back to BANK_SECRETS_KEY, then JWT_SECRET). Do not change it
# later without resetting everyone's authenticator.
MFA_ENCRYPTION_KEY=
STAFF_JWT_EXPIRES_IN=12h
# Largest single wallet adjustment / bonus / company credit request a normal admin may make (a Super Admin is not limited).
ADMIN_WALLET_ADJUST_MAX=200000
# Where the landing-page "request a demo" form sends a notification (leave empty to only store requests).
DEMO_NOTIFY_EMAIL=

# M12
# CORS: Vercel preview wildcard is OFF in production unless set (staging only).
ALLOW_VERCEL_PREVIEW_ORIGINS=false
# Destructive dev scripts: DB host must be local unless listed here (comma-separated). Leave empty in production.
DESTRUCTIVE_SCRIPT_ALLOWED_HOSTS=

# ─── M13 ──────────────────────────────────────────────────────────────────────
# Which vehicle categories are in service (CAR for the Lagos pilot). Default: CAR,MOTORCYCLE,VAN. TRICYCLE is out until listed.
ENABLED_VEHICLE_CATEGORIES=CAR
# Licence classes permitted per category. SET ONLY AFTER QUALIFIED NIGERIAN ADVICE. No rule configured = drivers blocked (fails closed).
LICENCE_CLASS_RULES={"CAR":["<class from adviser>"]}
# true/false. Default: ON when NODE_ENV=production, OFF otherwise.
ENFORCE_LICENCE_ELIGIBILITY=true
# Trip-completed outbox worker (set to "off" only on a secondary instance); attempts before dead-letter.
OUTBOX_WORKER=on
OUTBOX_MAX_ATTEMPTS=8

# ─── M14: map provider (these are only STARTING defaults; the admin console setting wins) ───
MAP_RENDERER=maplibre            # maplibre | google | osm
MAP_ROUTING_PROVIDER=osrm        # osrm | google
MAP_PLACES_PROVIDER=auto         # auto | photon | google
MAP_STYLE_URL=                   # https MapLibre style (optional)
OSRM_URL=                        # YOUR routing server (the public demo is dev-only)
GOOGLE_ROUTES_API_KEY=           # server-side; enables Google routing in the admin console
# M14 production: the public OSRM demo is refused in production. Only set this to true for a deliberate, temporary exception.
# ALLOW_PUBLIC_OSRM=false

# ── Multi-provider payments / MTN MoMo (DISABLED until Admin enables it AND MTN onboarding is approved) ──
# SANDBOX (default) or LIVE. LIVE must be set explicitly and only after written MTN production approval.
PAYMENT_PROVIDER_ENVIRONMENT=SANDBOX
# Optional: 32 random bytes, base64 (openssl rand -base64 32). Enables Admin secret entry/rotation (stored AES-256-GCM encrypted).
# Without it, set provider secrets below as backend environment variables. NEVER use VITE_* / EXPO_PUBLIC_* for any of these.
PAYMENT_SECRETS_KEY=
# Public base URL of THIS backend (used to build provider callback URLs), e.g. https://api.example.com
API_BASE_URL=
# MTN MoMo Collection — names follow MTN's API terms; confirm against the docs MTN issues to Elorge.
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_SECRET=
MTN_MOMO_BASE_URL=
MTN_MOMO_TARGET_ENVIRONMENT=

# Payment sweeper (re-checks pending MoMo payments). Default on, every 5 min.
# PAYMENT_SWEEPER_ENABLED=true
# PAYMENT_SWEEPER_INTERVAL_MS=300000

# ── Guest planning (preview only) ─────────────────────────────────────────────
# POST /api/guest/quote serves signed, expiring ESTIMATES from a real provider route. Default OFF; enable per environment.
# It never creates a ride or delivery. Guest booking (OTP, idempotency, scoped tracking) is a later, separately secured stage.
GUEST_PLANNING_ENABLED=false
# M16: GUEST_QUOTE_SECRET is REQUIRED in production when planning or booking is on (32+ random chars). Dev/test fall back to JWT_SECRET.
#      Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# GUEST_QUOTE_SECRET=

# ── Guest booking (M15/M16) — default OFF. Booking requires GUEST_PLANNING_ENABLED=true as well. ──
GUEST_BOOKING_ENABLED=false
# Separate 32+ char secret for guest identity / OTP / session hashing. Must differ from JWT_SECRET and GUEST_QUOTE_SECRET.
# Production will NOT fall back to JWT_SECRET and refuses to start without it when booking is enabled.
# GUEST_HASH_SECRET=
# Absolute https URL of the deployed public tracking page (this API serves it at /t). Required when booking is enabled.
# GUEST_TRACKING_BASE_URL=https://api.example.com/t
# M16.1: guest verification is EMAIL-first. SMS OTP stays off until it is enabled deliberately (see GUEST_SMS_OTP_ENABLED below).
# Tracking-link / recipient-code SMS (optional) still needs ENABLE_SMS_DELIVERY=true plus TERMII_API_KEY and TERMII_SENDER_ID.
# M16: tracking-link and recipient-code SMS go through a durable outbox with retry. Optional tuning:
# SMS_OUTBOX_WORKER=off          # disable the delivery worker on this node
# SMS_OUTBOX_MAX_ATTEMPTS=6      # tries before a message is dead-lettered (visible in Admin)

# ── M16.2: recipient hand-over code + tracking link. Each channel has its OWN flag, independent of the guest OTP flags. ─────────
# Pilot: email ON, SMS OFF. When EMAIL is on and SMS is off, the parcel recipient's email is REQUIRED at booking.
EMAIL_DELIVERY_NOTIFICATIONS_ENABLED=false   # recipient gets the code + tracking link by email (needs Brevo/Resend configured below)
SMS_DELIVERY_NOTIFICATIONS_ENABLED=false     # keep false until an SMS provider, sender ID, cost and live delivery are approved. Unset falls back to ENABLE_SMS_DELIVERY.
SENDER_TRACKING_EMAIL_ENABLED=false          # also email the tracking link to the sender (costs 1 email/booking of the daily quota). The app already lets the sender copy/share it.
POD_CODE_SENDER_VISIBLE=false                # false = once the recipient's EMAIL carries the code the sender's app no longer shows it. true = always show it to the sender (not recommended)
RECIPIENT_RESEND_COOLDOWN_SECONDS=120        # minimum gap between Admin resends for one booking

# ── M16.1: guest email OTP, Brevo (primary) + Resend (second tier). Placeholders only: NEVER commit real keys. ──────────────
# Verification channel. Both the flag AND the channel list must enable a channel. Start with email only.
GUEST_OTP_CHANNEL=email                  # email | sms | email,sms
GUEST_EMAIL_OTP_ENABLED=false            # keep false until Brevo is configured and tested
GUEST_SMS_OTP_ENABLED=false              # keep false until an SMS provider, its cost and delivery have been checked
GUEST_OTP_TTL_SECONDS=300
GUEST_OTP_MAX_ATTEMPTS=5
GUEST_OTP_RESEND_COOLDOWN_SECONDS=60
# GUEST_OTP_MAX_SENDS_PER_EMAIL_HOUR=5
# GUEST_OTP_DAILY_CAP=0                  # optional global cap on OTP requests per rolling 24h (0 = off)
# Dedicated 32+ char secret for OTP hashing / code derivation. NO fallback to JWT_SECRET. Must differ from every other secret.
# GUEST_OTP_HASH_SECRET=

# Providers. Keys live ONLY here (backend). Never in the mobile app, Admin frontend, source control or screenshots.
BREVO_ENABLED=false
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@your-authenticated-domain.example
BREVO_SENDER_NAME=Runserv
# BREVO_API_BASE_URL=https://api.brevo.com/v3     # optional; must be https://api.brevo.com
# BREVO_WEBHOOK_SECRET=                            # bearer token configured on the Brevo webhook -> POST /api/email-webhooks/brevo
RESEND_ENABLED=false
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=no-reply@your-authenticated-domain.example
# RESEND_WEBHOOK_SECRET=whsec_...                  # Resend/Svix signing secret -> POST /api/email-webhooks/resend

# Two-provider quota routing: sends 1-300 of the window -> Brevo, 301-400 -> Resend, beyond -> stay queued.
# Never set an allocation above the provider's REAL account limit (check the dashboards before a pilot).
EMAIL_PROVIDER_ROUTING=quota_tiered
BREVO_DAILY_ALLOCATION=300
RESEND_DAILY_ALLOCATION=100
EMAIL_SEND_HARD_CAP=400
EMAIL_QUOTA_WINDOW_TIMEZONE=UTC          # PROVISIONAL: confirm each provider's reset behaviour before relying on it
EMAIL_QUOTA_RESET_OFFSET_MINUTES=60      # conservative: the window boundary is moved LATER, never earlier
EMAIL_FAILOVER_ON_TRANSIENT_ERROR=true   # an outage may use Resend slots, so 400 total is NOT guaranteed during an outage
# EMAIL_PROVIDER_TIMEOUT_MS=8000
# EMAIL_OUTBOX_MAX_ATTEMPTS=6
# EMAIL_OUTBOX_WORKER=off                # disable the delivery worker on this node

# ── M16.2.1: hand-over code lifecycle, pilot scope, tracking policy ───────────────────────────────────────────
# REQUIRED (production refuses to start without them while EMAIL_DELIVERY_NOTIFICATIONS_ENABLED=true). Product/operations choose; there is NO default.
POD_CODE_TTL_HOURS=                 # hand-over code expiry in hours (0 < n <= 720). Decide, then set.
PARCEL_PILOT_SCOPE=guest_only       # guest_only = registered-customer parcels are refused during the pilot (Option A)
POD_EXCEPTION_FOUR_EYES=true        # manual hand-over exception: a DIFFERENT operator must approve; false only for one-person teams (logged)
GUEST_TRACKING_TTL_HOURS=24         # tracking link lifetime; an ACTIVE booking's link slides forward when opened near its end
GUEST_TRACKING_MAX_HOURS=72         # hard ceiling from booking time
