{
  "name": "runserv-backend",
  "version": "1.0.0",
  "description": "Backend API for Runserv - Ride Hailing & Delivery Platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "npx prisma generate",
    "studio": "npx prisma studio",
    "seed": "node prisma/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "prisma generate || true",
    "billing:run": "node scripts/run-monthly-billing.js",
    "test:coverage": "jest --coverage",
    "db:init": "node scripts/db-init.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check-ledger": "node scripts/ledger-check.js",
    "seed:admin": "node prisma/seed-admin.js",
    "test:pg": "node tests/pg/concurrency.pg.js",
    "db:rehearse": "bash scripts/rehearse-migrations.sh",
    "db:apply-sql": "bash scripts/apply-sql.sh",
    "db:baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/baseline.sql",
    "db:rehearse-full": "bash scripts/rehearse-full.sh",
    "db:opening-balances": "node scripts/ledger-opening-balances.js",
    "staging:check": "node scripts/staging-check.js",
    "db:backup-drill": "bash scripts/backup-drill.sh"
  },
  "keywords": [
    "ride-hailing",
    "delivery",
    "nigeria",
    "paystack",
    "flutterwave"
  ],
  "author": "Runserv",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "agora-token": "^2.0.5",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^9.14.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "4.0.0",
    "nodemailer": "^10.6.0",
    "socket.io": "^4.6.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "pg": "^8.23.1",
    "prisma": "^5.9.0",
    "supertest": "^7.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
